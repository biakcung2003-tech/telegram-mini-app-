# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
# Public URL of this backend (used for S2S callback base, bot webhook, etc.)
PUBLIC_BACKEND_URL=http://localhost:8080
# Comma-separated list of allowed CORS origins (your frontend URLs)
CORS_ORIGINS=http://localhost:5173

# ──────────────────────────────────────────────────────────────
# Telegram
# ──────────────────────────────────────────────────────────────
# From BotFather. NEVER commit a real token.
BOT_TOKEN=123456:your-bot-token-here
# The https URL where your Mini App frontend is hosted (Cloudflare Pages)
MINI_APP_URL=https://your-mini-app.pages.dev
# Bot launch mode: "polling" (dev) or "webhook" (prod)
BOT_MODE=polling
# Required only when BOT_MODE=webhook
BOT_WEBHOOK_DOMAIN=
# Max age (seconds) of Telegram initData accepted by the server
INITDATA_MAX_AGE_SECONDS=86400

# ──────────────────────────────────────────────────────────────
# Auth / secrets  (generate long random strings!)
# ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
# Signs one-time ad-unlock grant tokens
GRANT_SECRET=change-me-to-another-long-random-string
# Admin bootstrap credentials (first run creates this admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ──────────────────────────────────────────────────────────────
# Ad providers
# ──────────────────────────────────────────────────────────────
# Comma-separated list of ENABLED rewarded providers.
# Allowed values: "manual" (DEV ONLY). Real providers are configured in the
# admin panel. "manual" is force-disabled when NODE_ENV=production.
ENABLED_AD_PROVIDERS=manual
# Shared secret used to validate server-to-server reward callbacks from a
# rewarded-ad network (per-provider override possible in admin config).
AD_S2S_SECRET=change-me-s2s-secret

# ──────────────────────────────────────────────────────────────
# Adsterra (SmartLink is a SPONSORED LINK only — never unlocks content)
# ──────────────────────────────────────────────────────────────
# Optional default SmartLink; admins can override in the panel.
ADSTERRA_SMARTLINK_URL=
